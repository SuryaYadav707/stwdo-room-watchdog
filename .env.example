# Copy to .env and fill in. Never commit .env.

# Telegram bot. Create via @BotFather, then message your bot once and read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
STWDO_TELEGRAM_BOT_TOKEN=
STWDO_TELEGRAM_CHAT_ID=

# Optional: only needed if llm.enabled is true in config.yaml
ANTHROPIC_API_KEY=
